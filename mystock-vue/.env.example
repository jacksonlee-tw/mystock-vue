# =============================================================================
# 根目錄環境變數範本 — 複製為 .env.prod / .env.test / .env.dev / .env.local
# （本機熱重載開發則複製為 .env，供 docker-compose.dev.yml 使用）
# =============================================================================
# 這些變數同時服務兩種用途：
#   1. 透過 --env-file 提供給 docker-compose.yml 做「插值」（ports、container_name 等）
#   2. 由 backend 服務的 env_file: 載入，成為容器內程式實際讀到的環境變數
# 因此啟動時務必使用 --env-file 明確指定，不可省略（見 docker-compose.yml 檔頭說明）。

# ── 部署環境識別（docker-compose.yml 依此建立容器名稱、決定載入哪一份 .env.<環境>）
# main branch → prod、test branch → test、dev branch → dev；local 為本機驗證用，不對應分支。
# 值必須與檔名後綴一致，複製本檔為 .env.dev 時請改成 dev，依此類推。
APP_ENV=dev

# ── 對外埠號（host port）。四個環境預設值彼此不重複，同一台主機可同時跑多個環境。
BACKEND_PORT=8002
FRONTEND_PORT=8082
POSTGRES_PORT=5434

# ── 前端建置：API 走相對路徑，由 frontend/nginx.conf 反向代理到 backend:8000，
#    同一份建置產物換環境／換主機都不需要重新建置。
VITE_API_BASE=/api/v1

MONTHS_RANGE=3

# --- 季報 EPS 回溯抓取的季數（見 services/mops_eps_fetcher.py） ---
QUARTERS_RANGE=4

# --- 啟用的市場（逗號分隔，目前支援 tw / us） ---
ENABLED_MARKETS=tw,us

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=postgres

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90

# ── PostgreSQL
# ⚠️ 本檔為可安全進版控的範本值，正式環境請務必更換為強密碼。
# 注意：以 docker-compose.yml 啟動時，backend 服務會把 POSTGRES_HOST 覆寫成容器內部網路的
# 服務名稱 db，這裡的 localhost 只適用本機直接執行 uvicorn 的情境。
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
