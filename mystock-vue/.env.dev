# dev branch → dev → 本檔（.env.dev）。值必須與檔名後綴一致。
# ⚠️ 本檔可安全進版控（無真實機密），POSTGRES_PASSWORD 為範本值，正式使用前請更換。
APP_ENV=dev

# ── 對外埠號（host port）
BACKEND_PORT=8002
FRONTEND_PORT=8082
POSTGRES_PORT=5434

# ── 前端建置：API 走相對路徑，由 frontend/nginx.conf 反向代理到 backend:8000
VITE_API_BASE=/api/v1

# ── 後端：追蹤的股票代號（逗號分隔）
STOCK_CODES=0050,2330,2317,006208
MONTHS_RANGE=3
US_STOCK_CODES=AAPL,MSFT,GOOGL,TSLA
QUARTERS_RANGE=4
ENABLED_MARKETS=tw,us

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=postgres

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90

# ── PostgreSQL（範本值，請依實際 dev 主機調整）
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change-me-dev
POSTGRES_HOST=localhost
