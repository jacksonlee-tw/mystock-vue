# PostgreSQL 容器資料與備份檔（見 docker-compose.yml），不進版控
postgres_data/
backups/

__pycache__/
*.pyc

# 爬蟲每日下載的個股資料快取，可隨時重新抓取，不需要版控
# （見 docs/#Architecture/系統規格書/系統設計規格書.md 第 12 節；data/_alerts/ 是警示狀態，非爬蟲資料，維持版控）
data/*.json
data/tw/*.json
data/us/*.json

# 大盤指數資料快取（見 services/index_fetcher.py），與個股資料同理不進版控
data/tw/_indices/*.json
data/us/_indices/*.json

# 個股產業標籤快取（見 services/industry_fetcher.py），同理不進版控
data/tw/_meta/*.json
data/us/_meta/*.json

# 新聞／總經兩段式落地的第一階段緩衝檔（見 services/news_fetcher.py、services/macro_fetcher.py、
# docs/16.AI技術分析/Phase4-輕量化新聞輿情與總經監控.md ADR-P4-04）：每次抓取都會新增一個
# 帶時間戳記的檔案，是本機重跑用的暫存快照，不是像 data/_alerts/ 那樣的應用程式狀態，
# 不進版控（否則每天抓取都會持續膨脹 repo 體積）。
data/_news/
data/_macro/

# 概念股標籤是人工維護的種子資料（見 services/concept_tag_service.py、
# docs/17.熱力圖概念股標籤分類/概念股標籤分類_規劃書.md ADR-CT4），不是爬蟲快取，
# 比照 strategy_config/strategies.yaml（人工維護的設定檔）維持版控，故從上面的忽略規則中排除。
!data/tw/_meta/concept_tags.json
!data/us/_meta/concept_tags.json
