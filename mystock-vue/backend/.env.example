# 追蹤的股票代號（逗號分隔）
STOCK_CODES=0050,2330,2317,006208
MONTHS_RANGE=3
US_STOCK_CODES=AAPL,MSFT,GOOGL,TSLA

# --- 季報 EPS 回溯抓取的季數（見 services/mops_eps_fetcher.py） ---
QUARTERS_RANGE=4

# --- 啟用的市場（逗號分隔，目前支援 tw / us） ---
ENABLED_MARKETS=tw,us

# --- PostgreSQL ---
# 注意：以 docker-compose 啟動時，app 服務會把 POSTGRES_HOST 覆寫成容器內部網路的
# 服務名稱 db（見 docker-compose.yml），這裡的 localhost 只適用本機直接執行 uvicorn 的情境。
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=json

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90
