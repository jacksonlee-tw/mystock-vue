# ============================================================
# backend/.env —— 「本機直接執行後端」與「backend/docker-compose.yml」共用的設定檔
# ============================================================
# 這個檔案不是專案唯一的環境設定檔，另外還有根目錄那一組。搞混過一次，先寫清楚：
#
#   backend/.env（本檔）
#     ├─ 本機 `python main.py`：config.py／ai/config.py／notify/config.py／
#     │  industry_chain/config.py 都是 load_dotenv(BASE_DIR/".env")，BASE_DIR 即 backend/
#     └─ backend/docker-compose.yml：以 `- ./.env:/app/.env` bind-mount 進容器
#
#   根目錄 .env.prod／.env.test／.env.dev／.env.local
#     └─ 根目錄 docker-compose.yml 的 full-stack 部署，走 `env_file: .env.${APP_ENV}`，
#        **完全不會讀到本檔**。根目錄那個純 .env 則是給 docker-compose.dev.yml 用的。
#
# ⚠️ 本檔仍會被程式自己整份重寫（見 config.py 的 save_schedule_config()，供下方排程設定使用）。
#    因此請勿把它當成部署設定檔共用，也不要在裡面放註解以外的手工排版 —— 重寫後不保證保留。
#    追蹤股票號碼（原 STOCK_CODES/US_STOCK_CODES）2026-08-30 起已改存 Postgres
#    `portfolio_watchlist`（is_crawl_enabled=TRUE），不再讀寫本檔，管理入口見「追蹤與觀察名單」頁
#    （/api/v1/watchlist、/api/v1/stocks/tracked）。
#
# ⚠️ 密鑰要自己同步：本檔與根目錄那組是各自獨立的檔案，改了一邊不會同步另一邊。
#    實際踩過的坑：GEMINI_API_KEY 只留在根目錄 .env，本檔漏了，於是本機跑的後端
#    一律回報「尚未設定 API 金鑰」，但 Docker 那條路徑卻是好的，很難聯想到原因。
#    要避免長期漂移，也可改成不寫在任何 .env、只設成作業系統環境變數
#    （load_dotenv 找不到就會落回 os.getenv；但注意各處都是 override=True，
#    只要檔案裡還留著同名的一行，就會蓋過作業系統的值）。
# ============================================================

MONTHS_RANGE=3

# --- 季報 EPS 回溯抓取的季數（見 services/mops_eps_fetcher.py） ---
QUARTERS_RANGE=4

# --- 啟用的市場（逗號分隔，目前支援 tw / us） ---
ENABLED_MARKETS=tw,us

# --- PostgreSQL ---
# 注意：以 docker-compose 啟動時，app 服務會把 POSTGRES_HOST 覆寫成容器內部網路的
# 服務名稱 db（見 docker-compose.yml），這裡的 localhost 只適用本機直接執行 uvicorn 的情境。
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=json

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90

# ============================================================
# --- 整合訊息通知平台（Email + Telegram，見系統開發規格書） ---
# 注意：需先跑過 db/migration/V3__Create_notification_platform.sql 與
# V4__Add_recipient_preference_ceiling.sql（docker compose up -d 會自動套用）
# ============================================================
NOTIFY_ENABLED=false
# Fernet 金鑰：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTIFY_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:5173

# --- 管理端授權（FR-AU） ---
# OWNER_PASSWORD_HASH：python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
OWNER_PASSWORD_HASH=
OWNER_API_TOKEN=
OWNER_SESSION_TTL_HOURS=12

# --- 發送調度（可調門檻，鐵則 R8） ---
NOTIFY_POLL_INTERVAL_SEC=10
NOTIFY_BATCH_SIZE=20
NOTIFY_MAX_RETRY=3
NOTIFY_RETRY_BACKOFF_SEC=60,300,1800
NOTIFY_STUCK_TIMEOUT_MIN=10
NOTIFY_CIRCUIT_THRESHOLD=5
NOTIFY_CIRCUIT_COOLDOWN_SEC=300
NOTIFY_CIRCUIT_COOLDOWN_MAX_SEC=3600

# --- 通知政策預設值 ---
NOTIFY_DEFAULT_DAILY_LIMIT=30
NOTIFY_DEFAULT_QUIET_START=22:00
NOTIFY_DEFAULT_QUIET_END=08:00
NOTIFY_DEFAULT_TIMEZONE=Asia/Taipei
NOTIFY_DEFAULT_STRENGTHS=strong,moderate
NOTIFY_DIGEST_TIME_TW=15:00
NOTIFY_DIGEST_TIME_US=07:00
NOTIFY_LOG_RETENTION_DAYS=90

# --- Email 管道（個人信箱寄送，SMTP 帳密於管理介面填寫並加密存 DB，不放這裡）---
NOTIFY_EMAIL_DAILY_BUDGET=350
NOTIFY_RATE_EMAIL_PER_MIN=30
NOTIFY_EMAIL_SUBJECT_PREFIX=【MyStock】

# --- Telegram 管道 ---
NOTIFY_RATE_TELEGRAM_PER_MIN=20
TELEGRAM_WEBHOOK_BASE=
TELEGRAM_WEBHOOK_SECRET=

# --- 開發／驗收輔助 ---
NOTIFY_DRY_RUN=false
NOTIFY_ALLOW_INSECURE_COOKIE=false

# --- 每日抓取＋策略掃描排程（見 services/scheduler.py）---
# 時間為 24 小時制 HH:MM，一律以 SCHEDULE_TIMEZONE 解讀。
# 可於前端「股票與爬蟲管理 → 每日自動排程」設定，存檔後即時套用、不需重啟。
# 各市場的通知健康檢查會自動排在抓取時間 60 分鐘後，不需另外設定。
SCHEDULE_TIMEZONE=Asia/Taipei
TW_SCHEDULE_TIME=14:30
TW_SCHEDULE_ENABLED=true
US_SCHEDULE_TIME=06:00
US_SCHEDULE_ENABLED=true

# ============================================================
# --- AI 技術分析報告（backend/ai/，見 docs/16.AI技術分析/AI技術分析規劃.md）---
# 前置需求：本模組需要 PostgreSQL（不受 DATA_SOURCE 影響，見規格書 ADR-AI-14），
#           且需先套用 db/migration/V14__Create_ai_analysis_tables.sql
#           （docker compose up -d 會自動套用）
# ============================================================
# 總開關：預設關閉。啟用後每次點擊「AI 診股報告」都會產生實際 API 費用。
AI_ANALYSIS_ENABLED=false

# 預設 Provider（claude | gemini）；前端可於請求中指定覆寫
AI_DEFAULT_PROVIDER=claude

# --- Claude（Anthropic）---
# 金鑰取得：https://console.anthropic.com/
# ⚠️ 只填在「未納入版本控制」的檔案裡，不得出現在任何被 commit 的檔案（含本 .example）。
#    可以放：backend/.env、根目錄 .env、根目錄 .env.local —— 這三個都在 .gitignore 內。
#    絕對不要放：根目錄 .env.prod／.env.test／.env.dev —— 這三個是「已進版控」的範本檔，
#    檔頭自己就寫明「本檔可安全進版控（無真實機密）」，填了真金鑰就會直接外洩。
#    若正式部署需要金鑰，改用執行 compose 那個 shell 的環境變數傳入，不要寫進範本檔。
#    另注意：能放的那三個檔案彼此獨立、不會互相同步，改一邊不會影響另一邊。
CLAUDE_API_KEY=
# 模型 ID 不得寫死在程式碼（ADR-AI-12）。
# claude-sonnet-5：成本較低，適合日常使用；claude-opus-5：判讀品質最佳，成本約 2.5 倍
CLAUDE_MODEL=claude-sonnet-5

# --- Gemini（Google）---
# 金鑰取得：https://aistudio.google.com/apikey
# ⚠️ 只填在「未納入版本控制」的檔案裡，不得出現在任何被 commit 的檔案（含本 .example）。
#    可以放：backend/.env、根目錄 .env、根目錄 .env.local —— 這三個都在 .gitignore 內。
#    絕對不要放：根目錄 .env.prod／.env.test／.env.dev —— 這三個是「已進版控」的範本檔，
#    檔頭自己就寫明「本檔可安全進版控（無真實機密）」，填了真金鑰就會直接外洩。
#    若正式部署需要金鑰，改用執行 compose 那個 shell 的環境變數傳入，不要寫進範本檔。
#    另注意：能放的那三個檔案彼此獨立、不會互相同步，改一邊不會影響另一邊。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 成本與併發控管 ---
# 注意：「同一標的同一交易日只呼叫一次 LLM」是資料庫唯一鍵強制的，不需設定；
#       以下為「全站每日新報告總量」的第二層防線。
AI_DAILY_QUOTA=20              # 每日可產生的「新」報告總數（回讀既有報告不計入）
AI_STUCK_TIMEOUT_MIN=10        # running 超過此分鐘數視為孤兒，可被接手
AI_REQUEST_TIMEOUT_SEC=90      # 後端呼叫 Provider 的逾時上限
AI_MAX_OUTPUT_TOKENS=8000      # 過低會截斷報告
AI_MAX_IMAGE_MB=4              # 超過即回報前端錯誤

# --- 紀錄保留 ---
AI_REPORT_RETENTION_DAYS=365        # ai_analysis_report 保留天數
AI_EXECUTION_RETENTION_DAYS=730     # ai_llm_execution 保留天數（成本紀錄刻意留較久）
AI_ACTIVITY_LOG_RETENTION_DAYS=365  # activity_log 保留天數

# --- 提示詞版本 ---
# 改動 ai/prompt.py 的提示詞內容時手動遞增，讓歷史報告可回溯是用哪版產生的
AI_PROMPT_VERSION=v4

# --- 開發除錯用（正式環境務必保持 false）---
# 啟用後請求可帶 force:true 覆寫當日既有報告，會重複計費
AI_ALLOW_FORCE_REGENERATE=false

# ============================================================
# --- 產業鏈知識圖譜（backend/industry_chain/，見 docs/16.AI技術分析/
#     Phase3-產業鏈知識圖譜與輪動模型.md）---
# 前置需求：圖查詢需要 PostgreSQL（不受 DATA_SOURCE 影響，見 ADR-IC-01），
#           且需先套用 db/migration/V19__Create_industry_chain_tables.sql／
#           V20__Add_granger_columns_to_lead_lag_cache.sql
# ============================================================
# 總開關：預設關閉。啟用後 §4.6 的每月排程工作（LLM 萃取／CCF 重算／脫鉤監控）才會實際執行。
INDUSTRY_CHAIN_ENABLED=false

# --- LLM 萃取成本閘門（見 ai/config.py 的 get_industry_chain_monthly_call_cap()）---
IC_LLM_MONTHLY_CALL_CAP=20     # 本模組每月呼叫上限，AI_DAILY_QUOTA 數不到本模組的呼叫

# --- Stage B（industry_chain_extract）預設模型，獨立於 ai/config.py 的 GEMINI_MODEL ---
# 留空＝退回 ai_config.get_gemini_model()（與 AI 診股報告共用的全站預設，見 get_extract_model()）。
# 只想讓本模組先行升級模型、不影響 AI 診股報告的預設時才需要設這個鍵。
IC_LLM_EXTRACT_MODEL=gemini-3.5-flash

# --- 篩選行為 ---
IC_MAX_BFS_TIER=2              # BFS 向上游收集的最大關聯層級（FR-11）
IC_REQUIRE_VERIFIED_EDGE=true  # 雷達清單是否只採用 is_verified=true 的邊（見 §5.2）

# --- FR-10 格蘭傑因果檢定（ADR-IC-05 延後已解除，見規格書修訂紀錄與新增 ADR-IC-22）---
# 讀取端見 industry_chain/lead_lag_job.py 的區域 _env_int()／_env_float()（刻意不經
# industry_chain/config.py，避免與同時擴充該檔的 §4.7.7 開發支線互相衝突）。
IC_GRANGER_MAX_LAG=30            # 掃描的延遲天數上限；實際會依樣本數再收斂（見 granger_causality()）
IC_GRANGER_ALPHA=0.05            # Benjamini-Hochberg 顯著性水準，套用在同一批次的全部配對上
# 比 IC_MIN_SAMPLE_SIZE（CCF，預設 120）高：VAR(lag) 迴歸比 CCF 的單純相關係數更吃樣本，
# 預設 150 是在 IC_GRANGER_MAX_LAG=30 時仍有安全邊際的下限（見 granger_causality() 的
# effective_max_lag 換算式：樣本數需 > 4*lag+5，30 天延遲約需 125 筆以上）
IC_GRANGER_MIN_SAMPLE_SIZE=150

# --- 兩段式 grounded 萃取（§4.7.7，ADR-IC-17）---
# 預設關閉：關閉時 Stage B 行為與 P0 版本完全一致（AC-IC-24），開啟後每次鏈萃取會多花一次
# 真實計費的 LLM 呼叫（Stage A 研究），獨立佔一列 ai_llm_execution（不併入月配額，見 extractor.py）。
IC_LLM_GROUNDING_ENABLED=false
IC_LLM_RESEARCH_MODEL=                    # 留空＝沿用該次呼叫已解析出的 Stage B 模型
IC_LLM_RESEARCH_LOOKBACK_MONTHS=12        # Stage A 研究「近期」供應鏈變動要回溯的月數
IC_LLM_REQUEST_TIMEOUT_SEC=180            # Stage A 開檢索工具通常比純結構化輸出慢，逾時秒數獨立設定
