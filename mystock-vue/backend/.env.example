# 追蹤的股票代號（逗號分隔）
STOCK_CODES=0050,2330,2317,006208
MONTHS_RANGE=3
US_STOCK_CODES=AAPL,MSFT,GOOGL,TSLA

# --- PostgreSQL ---
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=json

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90

# --- 整合訊息通知平台（Fernet 加密金鑰） ---
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTIFY_SECRET_KEY=
