# 追蹤的股票代號（逗號分隔）
STOCK_CODES=0050,2330,2317,006208,1101,1760,0056,00878,00981A,1909,2207,2308,2313,2884
MONTHS_RANGE=3
US_STOCK_CODES=AAPL,MSFT,GOOGL,TSLA,MU

# --- PostgreSQL ---
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=stock_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=json

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90

# --- 整合訊息通知平台（Fernet 加密金鑰） ---
NOTIFY_SECRET_KEY=kwxLAR2jmdiVrWNI0R9kIdo1ysAYORG5SGgp_IQVMVA=
NOTIFY_ENABLED=true

# --- Docker Compose 專案名稱 ---
# 本機還有其他專案的 compose 專案名稱預設也叫 "backend"（資料夾名），導致 image tag
# backend-app:latest 互相蓋掉；固定專案名避免撞名。db/backup/app 三個服務都已用
# container_name: 明確指定，不受這個名稱影響，只有 app 服務的 build image tag 會變成
# mystock-backup-app。
COMPOSE_PROJECT_NAME=mystock-backup

# --- 產業鏈知識圖譜（Phase 3，開發中）---
INDUSTRY_CHAIN_ENABLED=false
