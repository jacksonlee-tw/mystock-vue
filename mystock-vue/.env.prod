# main branch → prod → 本檔（.env.prod）。值必須與檔名後綴一致。
# ⚠️ 本檔可安全進版控（無真實機密），POSTGRES_PASSWORD 為範本值，正式部署前務必更換為強密碼。
APP_ENV=prod

# ── 對外埠號（host port）
BACKEND_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432

# ── 前端建置：API 走相對路徑，由 frontend/nginx.conf 反向代理到 backend:8000
VITE_API_BASE=/api/v1

MONTHS_RANGE=3
QUARTERS_RANGE=4
ENABLED_MARKETS=tw,us

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=postgres

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90

# ── PostgreSQL（⚠️ 正式環境請務必更換為強密碼，不要沿用此範本值）
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change-me-prod
POSTGRES_HOST=localhost
