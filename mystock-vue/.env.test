# test branch → test → 本檔（.env.test）。值必須與檔名後綴一致。
# ⚠️ 本檔可安全進版控（無真實機密），POSTGRES_PASSWORD 為範本值，正式使用前請更換。
APP_ENV=test

# ── 對外埠號（host port）
BACKEND_PORT=8001
FRONTEND_PORT=8081
POSTGRES_PORT=5433

# ── 前端建置：API 走相對路徑，由 frontend/nginx.conf 反向代理到 backend:8000
VITE_API_BASE=/api/v1

MONTHS_RANGE=3
QUARTERS_RANGE=4
ENABLED_MARKETS=tw,us

# --- 讀取來源切換（json | postgres） ---
DATA_SOURCE=postgres

# --- 啟動時缺漏回補的最大回望天數 ---
BACKFILL_MAX_DAYS=90

# ── PostgreSQL（範本值，請依實際測試主機調整）
POSTGRES_DB=mystock_db
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=change-me-test
POSTGRES_HOST=localhost
