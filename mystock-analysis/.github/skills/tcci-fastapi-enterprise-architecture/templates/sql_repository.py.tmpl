# backend/infrastructure/sql/xxx_repository.py（SQL Repository 實作）
"""XXX SQL Repository 實作

實作 XxxRepository 介面，透過 pyodbc 操作 MS SQL Server。
所有寫入操作不呼叫 conn.commit()，由 UoW 統一控制交易。
"""
import logging
from typing import Optional

from backend.db.session import COMP_NO, PLANT_NO, OP_USER
from backend.domain.ports.xxx_repository import XxxRepository

log = logging.getLogger(__name__)


class SqlXxxRepository(XxxRepository):
    """XXX SQL Repository — pyodbc MS SQL Server"""

    def __init__(self, conn):
        self._conn = conn

    def create(self, data: dict) -> dict:
        cur = self._conn.cursor()
        cur.execute(
            """
            INSERT INTO XXX_TABLE (compNo, plantNo, field1, field2)
            VALUES (?, ?, ?, ?)
            """,
            COMP_NO, PLANT_NO, data["field1"], data["field2"],
        )
        # ⚠️ 絕不呼叫 conn.commit()（由 UoW 統一控制交易）
        log.info("[SQL_CREATE] field1=%s", data["field1"])
        return data

    def get_by_id(self, xxx_id: str) -> Optional[dict]:
        cur = self._conn.cursor()
        cur.execute(
            "SELECT field1, field2 FROM XXX_TABLE WHERE id=? AND compNo=?",
            xxx_id, COMP_NO,
        )
        row = cur.fetchone()
        if not row:
            return None
        return {"id": xxx_id, "field1": row[0], "field2": row[1]}

    def list_all(self, limit: int = 100) -> list[dict]:
        cur = self._conn.cursor()
        cur.execute(
            "SELECT TOP(?) id, field1, field2 FROM XXX_TABLE WHERE compNo=? ORDER BY id DESC",
            limit, COMP_NO,
        )
        return [{"id": r[0], "field1": r[1], "field2": r[2]} for r in cur.fetchall()]

    def update(self, xxx_id: str, data: dict) -> None:
        cur = self._conn.cursor()
        cur.execute(
            "UPDATE XXX_TABLE SET field1=?, field2=? WHERE id=? AND compNo=?",
            data["field1"], data["field2"], xxx_id, COMP_NO,
        )
        # ⚠️ 不呼叫 commit

    def delete(self, xxx_id: str) -> None:
        cur = self._conn.cursor()
        cur.execute(
            "DELETE FROM XXX_TABLE WHERE id=? AND compNo=?",
            xxx_id, COMP_NO,
        )
        # ⚠️ 不呼叫 commit
